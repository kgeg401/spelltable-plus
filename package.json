{
  "name": "spelltable-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Commander webcam desktop app with matchmaking and local card recognition",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "node scripts/serve.mjs",
    "check": "npm test && npm run build",
    "desktop": "electron .",
    "desktop:four": "electron . --four-players",
    "desktop:verify": "electron . --four-players --verify",
    "desktop:package": "node scripts/package-desktop.mjs",
    "server": "node server/start.js",
    "desktop:verify-online": "electron . --four-players --verify --verify-matchmaking --verify-recognition --server=ws://127.0.0.1:47832",
    "desktop:verify-media": "electron . --four-players --verify --verify-media",
    "desktop:verify-relay": "node scripts/verify-relay.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.3",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "main": "desktop/main.js"
}
